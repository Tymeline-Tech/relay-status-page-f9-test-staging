# Dependencies are committed so offline verification containers can run
# `npm run validate:openapi` and `npm test` without network installs.
node_modules/.cache/

# Only ignore the project build output — never package dist/ folders under node_modules.
/dist/
*.log
.DS_Store

# Verification artifacts — produced by npm run validate:openapi / npm test
docs/openapi.yaml
client/src/api/generated/
!docs/.gitkeep
